          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"Traditional brass Thookkuvilakku (hanging oil lamps) with bells\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"Handmade lotus petal rangoli borders around ceremonial dais\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
