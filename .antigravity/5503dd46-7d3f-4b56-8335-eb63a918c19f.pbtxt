    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { InspirationItem } from \"../types/decoration\";\n\nexport const INSPIRATIONS: InspirationItem[] = [\n  {\n    id: \"moment-1\",\n    title: \"Twilight Arch Magic\",\n    category: \"Wedding\",\n    location: \"Perambra Valley View Hall\",\n    image: \"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"tall\",\n    caption: \"Golden hour lighting illuminating cascading white garden roses and crystal teardrops.\",\n  },\n  {\n    id: \"moment-2\",\n    title: \"Sacred Nilavilakku Glow\",\n    category: \"Traditional\",\n    location: \"Heritage Temple Auditorium, Balussery\",\n    image: \"https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"square\",\n    caption: \"Traditional seven-tiered brass lamps adorned with fresh fragrant jasmine strings.\",\n  },\n  {\n    id: \"moment-3\",\n    title: \"Modern Minimal Ivory Dais\",\n    category: \"Reception\",\n    location: \"Lakeside Convention Center, Calicut\",\n    image: \"https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"wide\",\n    caption: \"Textured fluted curves and floating candles designed for an intimate evening dinner.\",\n  },\n  {\n    id: \"moment-4\",\n    title: \"Vibrant Haldi Swings\",\n    category: \"Haldi\",\n    location: \"Private Courtyard, Vadakara\",\n    image: \"https://images.unsplash.com/photo-1545232979-8bf68ee9b1af?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"tall\",\n    caption: \"Yellow genda flower ropes with an authentic wooden jhula ready for laughter.\",\n  },\n  {\n    id: \"moment-5\",\n    title: \"Midnight Blue & Orchid Cascade\",\n    category: \"Reception\",\n    location: \"Grand Ballroom, Kozhikode\",\n    image: \"https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"square\",\n    caption: \"Fiber-optic constellation points softly framing white phalaenopsis orchids.\",\n  },\n  {\n    id: \"moment-6\",\n    title: \"Sunset Pampas & Bohemian Arch\",\n    category: \"Engagement\",\n    location: \"Poolside Lawn, Koyilandy\",\n    image: \"https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"tall\",\n    caption: \"Earthy pampas plumes paired with warm Edison lanterns under the Kerala palm trees.\",\n  },\n  {\n    id: \"moment-7\",\n    title: \"Traditional Padippura Entrance\",\n    category: \"Custom Designs\",\n    location: \"Heritage Manor, Perambra\",\n    image: \"https://images.unsplash.com/photo-1544077960-604201fe74bc?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"wide\",\n    caption: \"Ceremonial archway welcoming 800+ wedding guests with the fragrance of Kerala.\",\n  },\n  {\n    id: \"moment-8\",\n    title: \"Emerald & Gold Velvet Grandeur\",\n    category: \"Wedding\",\n    location: \"Royal Convention Hall, Malabar\",\n    image: \"https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=1000&q=80\",\n    aspectRatio: \"square\",\n    caption: \"Rich royal jewel tones framing the grand stage with custom golden moulding.\",\n  },\n];\n"
    }
