    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { TestimonialItem } from \"../types/decoration\";\n\nexport const TESTIMONIALS: TestimonialItem[] = [\n  {\n    id: \"review-1\",\n    clientName: \"Midhun & Anjali\",\n    eventType: \"Wedding & Reception\",\n    location: \"Perambra Town Auditorium\",\n    stageName: \"Royal Floral Wedding Stage\",\n    rating: 5,\n    quote: \"The stage looked even more breathtaking in person than in the photos. The fresh roses, lighting temperature, and carpet finish were immaculate. Our guests could not stop talking about the backdrop!\",\n    date: \"January 2026\",\n  },\n  {\n    id: \"review-2\",\n    clientName: \"Dr. Rahul & Dr. Divya\",\n    eventType: \"Evening Reception\",\n    location: \"Kozhikode Convention Center\",\n    stageName: \"Luxury Golden Glow Stage\",\n    rating: 5,\n    quote: \"Event Perambra handled every fine detail with remarkable professionalism. The golden jaali panels and warm lighting gave our wedding video a true cinematic luxury look. Prompt setup and zero stress.\",\n    date: \"December 2025\",\n  },\n  {\n    id: \"review-3\",\n    clientName: \"Sneha & Vivek\",\n    eventType: \"Traditional Kerala Wedding\",\n    location: \"Heritage Hall, Balussery\",\n    stageName: \"Kerala Heritage Wedding Decor\",\n    rating: 5,\n    quote: \"We wanted an authentic Kerala look with brass Nilavilakku and fresh jasmine rather than plastic decor. The team delivered 100% genuine Madurai jasmine and gorgeous carved wooden pillars. Deeply grateful!\",\n    date: \"February 2026\",\n  },\n  {\n    id: \"review-4\",\n    clientName: \"Ashiq & Fathima\",\n    eventType: \"Grand Nikah & Reception\",\n    location: \"Vadakara Beach Resort\",\n    stageName: \"Elegant Ivory Reception Setup\",\n    rating: 5,\n    quote: \"The ivory wisteria hanging canopy was pure magic when the evening lights came on. Coordinating everything over WhatsApp was so smooth and responsive. Best event decorators in Kozhikode district!\",\n    date: \"November 2025\",\n  },\n  {\n    id: \"review-5\",\n    clientName: \"Keerthi & Pranav\",\n    eventType: \"Haldi & Ring Ceremony\",\n    location: \"Private Courtyard, Koyilandy\",\n    stageName: \"Sunburst Marigold Haldi Haven\",\n    rating: 5,\n    quote: \"The marigold swing and brass urlis made our haldi photos look straight out of a designer magazine. They reached early in the morning and finished well before guests arrived.\",\n    date: \"January 2026\",\n  },\n];\n"
    }
