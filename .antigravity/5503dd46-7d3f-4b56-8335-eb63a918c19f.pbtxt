  file_change {
    absolute_path_uri: "file:///src/data/decorations.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { DecorationItem } from \"../types/decoration\";\n\nexport const DECORATIONS: DecorationItem[] = [\n  {\n    id: \"royal-floral-wedding-stage\",\n    name: \"Royal Floral Wedding Stage\",\n    category: \"Wedding\",\n    style: \"Luxury\",\n    tagline: \"Grandeur redefined through fragrant florals and regal architecture.\",\n    shortDescription: \"A magnificent cascading floral backdrop paired with warm crystal chandeliers and luxurious curved velvet seating.\",\n    fullDescription: \"Designed for couples dreaming of an opulent, grand wedding celebration. The Royal Floral Wedding Stage features lush cascades of fresh roses, orchids, and hydrangeas arranged across curved golden architectural arches. Warm ambient uplighting and genuine crystal chandeliers cast a romantic glow over the central ivory velvet double sofa, framing the bride and groom in breathtaking grandeur.\",\n    features: [\n      \"Lush cascading fresh roses, exotic orchids, and imported hydrangeas\",\n      \"Gilded curved architectural arches with bespoke crown moulding\",\n      \"Hand-hung warm crystal chandeliers with dimmable ambient glow\",\n      \"Luxury ivory velvet double seating with gold metallic trim\",\n      \"Elevated wooden stage platform with seamless carpet finishing\",\n      \"Integrated side floral pedestals and photogenic walkway borders\"\n    ],\n    specs: {\n      setupDuration: \"6 \342\200\223 8 Hours\",\n      backdropDimensions: \"32 ft (W) \303\227 14 ft (H)\",\n      floralType: \"100% Fresh premium roses, orchids & seasonal greens\",\n      lighting: \"Warm dimmable LED spot banks + warm crystal chandeliers\",\n      idealVenues: \"Auditoriums, convention centers & large banquet halls\",\n      seatingProvided: \"Custom curved royal ivory velvet double loveseat\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Ivory & Gold\", \"Blush Rose\", \"Champagne Gold\"],\n    featured: true,\n    isMostLoved: true,\n    badge: \"Signature Design\"\n  },\n  {\n    id: \"kerala-heritage-wedding-decor\",\n    name: \"Kerala Heritage Wedding Decor\",\n    category: \"Traditional\",\n    style: \"Traditional\",\n    tagline: \"Authentic Kerala traditions infused with brass glow and sacred florals.\",\n    shortDescription: \"Traditional Kerala temple-inspired wooden mandap with brass Nilavilakku, fresh jasmine, and marigold garlands.\",\n    fullDescription: \"Rooted deeply in God\'s Own Country\'s cultural heritage, this setup celebrates Kerala\'s timeless matrimonial elegance. Crafted with authentic teakwood carved pillars, golden marigold drapery, fragrant Madurai jasmine cascades, and radiant multi-tiered brass Nilavilakkus. Perfectly balanced with tender coconut hangings, fresh banana leaf motifs, and customary wooden charupadi accents.\",\n    features: [\n      \"Traditional Kerala carved timber pillars with temple roof motifs\",\n      \"Fragrant Madurai jasmine malas & fresh golden marigold garlands\",\n      \"Tiered authentic Kerala brass Nilavilakkus with sacred flame lighting\",\n      \"Custom wooden low-rise seating with royal brocade Kasavu cushions\",\n      \"Handcrafted brass urlis with floating lotus and rose petals\",\n      \"Traditional entrance toran with mango leaves and coconut blooms\"\n    ],\n    specs: {\n      setupDuration: \"5 \342\200\223 7 Hours\",\n      backdropDimensions: \"28 ft (W) \303\227 12 ft (H)\",\n      floralType: \"Authentic marigolds, fresh jasmine (Pichi), lotus & tuberose\",\n      lighting: \"Soft warm flood lighting & brass Nilavilakku flame ambience\",\n      idealVenues: \"Temple halls, heritage auditoriums & open-air courtyards\",\n      seatingProvided: \"Kasavu brocade upholstered wooden traditional settee\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1545232979-8bf68ee9b1af?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1544077960-604201fe74bc?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Kasavu Gold\", \"Deep Marigold Yellow\", \"Temple Brass\"],\n    featured: true,\n    isMostLoved: true,\n    badge: \"Kerala Traditional\"\n  },\n  {\n    id: \"elegant-ivory-reception-setup\",\n    name: \"Elegant Ivory Reception Setup\",\n    category: \"Reception\",\n    style: \"Modern\",\n    tagline: \"Pure sophistication framed in cascading wisteria and crystal accents.\",\n    shortDescription: \"A minimalist yet luxurious reception stage adorned with cascading white wisteria, mirror plinths, and crystal candelabras.\",\n    fullDescription: \"A showstopping contemporary backdrop tailored for modern evening receptions. The Elegant Ivory stage features a floor-to-ceiling textured white panel installation crowned with cascading white wisteria and soft English eucalyptus. Mirrored pedestals hold tall crystal candelabras that catch subtle warm light, providing photographers with stunning depth and bokeh.\",\n    features: [\n      \"Cascading white wisteria ceiling drape with micro-fairylight strings\",\n      \"Geometric fluted matte-white architectural backdrop panels\",\n      \"Tall tiered crystal candelabras with flickering warm candle fixtures\",\n      \"Modern cream boucl\303\251 designer loveseat\",\n      \"High-gloss reflective white runway dance floor / stage floor\",\n      \"Integrated discreet warm spotlighting tuned for wedding photography\"\n    ],\n    specs: {\n      setupDuration: \"5 \342\200\223 6 Hours\",\n      backdropDimensions: \"30 ft (W) \303\227 12 ft (H)\",\n      floralType: \"White wisteria, English eucalyptus, gypsophila & baby\'s breath\",\n      lighting: \"Concealed LED strip coving + crystal candle lamps\",\n      idealVenues: \"Air-conditioned reception halls, hotel ballrooms\",\n      seatingProvided: \"Curved cream boucl\303\251 designer sofa with bolster cushions\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1478146896981-b80fe463b330?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Ivory White\", \"Soft Champagne\", \"Frosted Silver\"],\n    featured: true,\n    isMostLoved: false,\n    badge: \"Modern Classic\"\n  },\n  {\n    id: \"dream-garden-engagement-stage\",\n    name: \"Dream Garden Engagement Stage\",\n    category: \"Engagement\",\n    style: \"Floral\",\n    tagline: \"A romantic botanical wonderland for your special promise.\",\n    shortDescription: \"Lush botanical floral archway illuminated by delicate fairy lights, blush pink peonies, and romantic lanterns.\",\n    fullDescription: \"Step into an enchanting secret garden. Built with organic asymmetric floral arches that interweave blush garden roses, ranunculus, and trailing ivy. Warm golden Edison bulbs hang gracefully at varied heights, creating a warm, dreamy environment that feels both whimsical and deeply intimate for modern ring ceremonies.\",\n    features: [\n      \"Organic asymmetrical botanical floral ring archway\",\n      \"Blush pink roses, ivory carnations & trailing English ivy\",\n      \"Suspended warm filament Edison bulbs with wooden pergola accents\",\n      \"Rustic brass lanterns along stage perimeter with wax candle look\",\n      \"Chic blush pink velvet scalloped armchair seating\",\n      \"Personalized couple\'s name monogram in warm LED neon\"\n    ],\n    specs: {\n      setupDuration: \"4 \342\200\223 5 Hours\",\n      backdropDimensions: \"24 ft (W) \303\227 11 ft (H)\",\n      floralType: \"Garden roses, ranunculus, eucalyptus & fresh ivy vines\",\n      lighting: \"Warm Edison suspended globes & fairy light curtains\",\n      idealVenues: \"Lawn venues, poolside decks & glass-front convention halls\",\n      seatingProvided: \"Blush velvet vintage twin chairs or scalloped loveseat\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1546815140-4ef85b8b7a42?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Blush Pink\", \"Sage Green\", \"Warm Ivory\"],\n    featured: true,\n    isMostLoved: true,\n    badge: \"Trending\"\n  },\n  {\n    id: \"luxury-golden-glow-stage\",\n    name: \"Luxury Golden Glow Stage\",\n    category: \"Reception\",\n    style: \"Luxury\",\n    tagline: \"Dazzling architectural symmetry with ambient golden warmth.\",\n    shortDescription: \"Layered golden lattice backdrop with dynamic warm architectural illumination and majestic floral pedestals.\",\n    fullDescription: \"Engineered for high-profile celebrations that demand awe-inspiring scale. The Luxury Golden Glow stage combines intricate laser-cut golden jaali panels, multi-dimensional LED cove lighting, and towering floral pedestals bursting with golden orchids and imported white lilies. The stage floor is polished to a glass mirror finish to reflect the ambient luminescence.\",\n    features: [\n      \"3D layered laser-cut golden filigree & jaali arch screens\",\n      \"Custom temperature-controlled warm amber cove lighting\",\n      \"Towering 8-foot floral plinths flanking the bride and groom\",\n      \"Gold-leaf gilded royal high-back throne seating\",\n      \"Seamless high-gloss reflective stage surface with safety edge-lighting\",\n      \"Walkway pillars with synchronised warm beam projection\"\n    ],\n    specs: {\n      setupDuration: \"7 \342\200\223 9 Hours\",\n      backdropDimensions: \"36 ft (W) \303\227 15 ft (H)\",\n      floralType: \"Yellow oncidium orchids, white calla lilies & monstera greens\",\n      lighting: \"RGBW architectural cove bars + 12 beam profile spotlights\",\n      idealVenues: \"Grand auditoriums, 5-star convention arenas\",\n      seatingProvided: \"Gilded baroque gold royal king/queen twin throne\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Royal Gold\", \"Warm Amber\", \"Rich Cream\"],\n    featured: true,\n    isMostLoved: true,\n    badge: \"Grand Luxury\"\n  },\n  {\n    id: \"sunburst-marigold-haldi-haven\",\n    name: \"Sunburst Marigold Haldi Haven\",\n    category: \"Haldi\",\n    style: \"Traditional\",\n    tagline: \"Joyful bursts of sunshine, fragrant genda, and playful festive warmth.\",\n    shortDescription: \"Vibrant yellow and orange marigold drapes, traditional floral jhula (swing), and brass urlis for the Haldi celebration.\",\n    fullDescription: \"A burst of joy and vibrant celebration. Hand-strung fresh marigold curtains in saffron and lemon yellow form the backdrop, complemented by an ornate floral-draped wooden swing (jhula) for the bride or groom. Large handcrafted brass urlis filled with fresh petals and floating brass diyas create the ultimate traditional Haldi ambiance.\",\n    features: [\n      \"Thick tiered marigold curtains in vibrant yellow & saffron hues\",\n      \"Solid teakwood swinging jhula draped in fresh jasmine & genda\",\n      \"Heavy antique brass urlis with fresh rose & marigold petals\",\n      \"Woven jute mats and colorful printed silk floor bolsters\",\n      \"Themed brass kalash vessels with mango sprigs and coconut\",\n      \"Fun photobooth props and flower shower baskets included\"\n    ],\n    specs: {\n      setupDuration: \"3 \342\200\223 4 Hours\",\n      backdropDimensions: \"20 ft (W) \303\227 10 ft (H)\",\n      floralType: \"100% Fresh Indian yellow & orange marigolds + Madurai jasmine\",\n      lighting: \"Natural day setup friendly + warm floodlights for evening\",\n      idealVenues: \"Home backyards, open courtyards, terrace gardens & banquet halls\",\n      seatingProvided: \"Hanging wooden floral swing with cushion or low brass stools\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1545232979-8bf68ee9b1af?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1544077960-604201fe74bc?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Marigold Yellow\", \"Saffron Orange\", \"Lime Green\"],\n    featured: true,\n    isMostLoved: true,\n    badge: \"Festive Favorite\"\n  },\n  {\n    id: \"vibrant-bohemian-mehndi-lounge\",\n    name: \"Vibrant Bohemian Mehndi Lounge\",\n    category: \"Mehndi\",\n    style: \"Boho\",\n    tagline: \"Eclectic colors, handwoven tapestries, and cozy floor lounges.\",\n    shortDescription: \"A colorful, vibrant celebration space featuring embroidered umbrellas, Moroccan brass lanterns, and low seating.\",\n    fullDescription: \"Designed to keep family and friends comfortable during hours of intricate henna application. This setting combines rich pink, turquoise, and mustard drapery with artisanal Rajasthani embroidered umbrellas, kilim floor rugs, brass lanterns, and cozy plush floor divans. The backdrop includes fairy lights and vibrant floral garlands that make every photograph pop.\",\n    features: [\n      \"Artisanal hand-embroidered mirror-work parasols and hanging tassels\",\n      \"Multi-hued silk draping with delicate micro-fairy light backdrop\",\n      \"Plush low-height upholstered divan couch with embroidered cushions\",\n      \"Moroccan pierced-brass lanterns with soft ambient interior bulbs\",\n      \"Intricately patterned kilim rugs and velvet floor cushions\",\n      \"Dedicated henna artist side tables and comfortable armrests\"\n    ],\n    specs: {\n      setupDuration: \"3 \342\200\223 4 Hours\",\n      backdropDimensions: \"22 ft (W) \303\227 10 ft (H)\",\n      floralType: \"Bougainvillea, multicolored gerberas & marigold tassels\",\n      lighting: \"Warm ambient lantern glow & fairy light wall\",\n      idealVenues: \"Outdoor pool deck, courtyard, resort lawn or banquet lounge\",\n      seatingProvided: \"Central velvet divan + 6 oversized embroidered floor poufs\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1545232979-8bf68ee9b1af?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1546815140-4ef85b8b7a42?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Fuchsia Pink\", \"Mustard Yellow\", \"Peacock Teal\"],\n    featured: false,\n    isMostLoved: false,\n    badge: \"Vibrant Boho\"\n  },\n  {\n    id: \"temple-arch-kerala-grand-entrance\",\n    name: \"Temple Arch Kerala Grand Entrance\",\n    category: \"Custom Designs\",\n    style: \"Traditional\",\n    tagline: \"A majestic first impression honouring Kerala\'s heritage.\",\n    shortDescription: \"Traditional Padippura-style entrance arch with hanging brass lamps, blooming jasmine, and banana tree guardians.\",\n    fullDescription: \"The entrance is the first promise of the celebration within. This grand traditional gateway incorporates authentic Kerala Padippura architecture, clay tile gables, tall brass deepams, tender coconut (karikku) clusters, and live floral arches of fresh marigold and jasmine. Guests step through an aromatic threshold that evokes the splendor of an ancient Kerala palace.\",\n    features: [\n      \"Traditional Kerala Padippura gabled wooden entrance portal\",\n      \"Twin towering ceremonial brass Nilavilakkus flanking the portal\",\n      \"Fresh golden banana trunks with natural fruit clusters\",\n      \"Hanging tender coconut (kuruthola) woven art & jasmine canopies\",\n      \"Carved wooden welcome easel with personalized Malayalam or English calligraphy\",\n      \"Red or golden runner carpet stretching 30 feet from entryway\"\n    ],\n    specs: {\n      setupDuration: \"4 \342\200\223 5 Hours\",\n      backdropDimensions: \"18 ft (W) \303\227 14 ft (H) Arch\",\n      floralType: \"Marigold garlands, jasmine ropes, kuruthola (tender palm)\",\n      lighting: \"Soft warm pathway spots & authentic oil lamp glow\",\n      idealVenues: \"Auditorium front gates, courtyard entrances & hall foyers\",\n      seatingProvided: \"N/A (Entrance Installation)\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1544077960-604201fe74bc?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Natural Timber\", \"Deep Gold\", \"Leaf Green\"],\n    featured: false,\n    isMostLoved: true,\n    badge: \"Grand Entry\"\n  },\n  {\n    id: \"regal-emerald-gold-palace-stage\",\n    name: \"Regal Emerald & Gold Palace Stage\",\n    category: \"Wedding\",\n    style: \"Luxury\",\n    tagline: \"Rich jewel tones meeting aristocratic golden arches.\",\n    shortDescription: \"Dramatic deep emerald velvet backdrop, tiered golden arches, and royal ivory seating for an unforgettable wedding.\",\n    fullDescription: \"A daring yet refined visual palette that exudes high royalty. The Regal Emerald setup pairs deep forest-green velvet draping with brushed champagne-gold arched columns. Rich burgundy and ivory roses, exotic deep-toned orchids, and gold-leafed palm fronds frame the stage, offering unmatched photographic contrast with bridal wedding attire.\",\n    features: [\n      \"Deep emerald velvet architectural backdrop panels\",\n      \"Champagne gold laser-cut baroque arch structures\",\n      \"Floral mix of deep burgundy roses, white lilies & golden eucalyptus\",\n      \"Custom royal double throne sofa with carved gold frame\",\n      \"Reflective emerald stage carpet with gold borders\",\n      \"Cinematic rim lighting calibrated for 4K video recording\"\n    ],\n    specs: {\n      setupDuration: \"6 \342\200\223 8 Hours\",\n      backdropDimensions: \"32 ft (W) \303\227 13 ft (H)\",\n      floralType: \"Imported burgundy roses, white Asiatic lilies & gold monstera\",\n      lighting: \"Cinematic narrow-beam LED framing spotlights\",\n      idealVenues: \"Large wedding halls, air-conditioned convention auditoriums\",\n      seatingProvided: \"Bespoke carved gold-leaf double throne sofa\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Emerald Green\", \"Champagne Gold\", \"Deep Crimson\"],\n    featured: true,\n    isMostLoved: false,\n    badge: \"Palace Theme\"\n  },\n  {\n    id: \"midnight-starlight-banquet-stage\",\n    name: \"Midnight Starlight Banquet Stage\",\n    category: \"Reception\",\n    style: \"Modern\",\n    tagline: \"An enchanting night sky constellation brought to life on stage.\",\n    shortDescription: \"Dramatic deep midnight blue drapery with hundreds of fiber-optic micro stars and pure white phalaenopsis orchids.\",\n    fullDescription: \"Inspired by clear Kerala night skies, this stage transports guests into an ethereal starlit dream. A seamless midnight-blue seamless backdrop is embedded with twinkling fiber-optic starlight points. Pure white phalaenopsis orchids and floating glass orbs with tea lights flank the stage, creating a deeply romantic and sophisticated atmosphere for evening dinners and receptions.\",\n    features: [\n      \"Deep midnight navy velvet backdrop with twinkle fiber-optic constellations\",\n      \"Pure white cascading phalaenopsis orchids on brushed steel pedestals\",\n      \"Suspended blown-glass bubble globes with flickering micro-candles\",\n      \"Minimalist modern white curved lounge sofa\",\n      \"Stage front LED waterfall curtain effect\",\n      \"Photographer-optimized spotlighting to prevent harsh shadows\"\n    ],\n    specs: {\n      setupDuration: \"5 \342\200\223 7 Hours\",\n      backdropDimensions: \"30 ft (W) \303\227 12 ft (H)\",\n      floralType: \"White cascading phalaenopsis orchids, white hydrangeas\",\n      lighting: \"Fiber-optic constellation points + warm follow spots\",\n      idealVenues: \"Indoor banquet halls & dark-interior convention centers\",\n      seatingProvided: \"Contemporary curved white leatherette designer sofa\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1478146896981-b80fe463b330?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Midnight Navy\", \"Starlight Silver\", \"Pure White\"],\n    featured: false,\n    isMostLoved: false,\n    badge: \"Starlit Night\"\n  },\n  {\n    id: \"boho-botanical-sunset-setup\",\n    name: \"Boho Botanical Sunset Setup\",\n    category: \"Engagement\",\n    style: \"Boho\",\n    tagline: \"Sun-bleached pampas, natural woods, and earthy romance.\",\n    shortDescription: \"Boho-chic stage with tall pampas grass plumes, dry floral textures, macrame hangings, and warm wood flooring.\",\n    fullDescription: \"Embrace the effortless grace of earthy bohemian styling. Natural fluffy pampas grass plumes, bleached ruscus, terracotta pottery, and natural timber arches create an organic and relaxed aesthetic. Completed with hand-knotted macrame backdrops, rattan peacock chairs, and soft amber uplighting that mimics a golden hour sunset.\",\n    features: [\n      \"Lush imported pampas grass plumes in natural & bleached tones\",\n      \"Dual concentric geometric wooden hexagonal arches\",\n      \"Hand-knotted artisanal macrame tapestry with fringe details\",\n      \"Iconic pair of natural rattan peacock wicker armchairs\",\n      \"Terracotta urns with dried florals and warm fairy lights\",\n      \"Rustic natural wood decking with woven seagrass rugs\"\n    ],\n    specs: {\n      setupDuration: \"4 \342\200\223 5 Hours\",\n      backdropDimensions: \"24 ft (W) \303\227 11 ft (H)\",\n      floralType: \"Pampas grass, preserved ruscus, blush roses, eucalyptus\",\n      lighting: \"Warm 2700K amber ground floods + Edison bulbs\",\n      idealVenues: \"Resort lawns, beachside weddings, garden settings\",\n      seatingProvided: \"Pair of iconic handcrafted bohemian rattan peacock chairs\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1546815140-4ef85b8b7a42?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Earthy Terracotta\", \"Pampas Beige\", \"Blush Cream\"],\n    featured: false,\n    isMostLoved: true,\n    badge: \"Boho Chic\"\n  },\n  {\n    id: \"enchanted-pastel-cloud-birthday\",\n    name: \"Enchanted Pastel Cloud Birthday Setup\",\n    category: \"Birthday\",\n    style: \"Modern\",\n    tagline: \"Whimsical clouds, dreamy pastels, and joyful celebrations.\",\n    shortDescription: \"Organic balloon and floral garland installation with pastel arches, customized neon sign, and cylinder plinths.\",\n    fullDescription: \"Created to celebrate milestones in high style. Whether it is a 1st birthday, sweet sixteen, or 50th golden celebration, this setup blends double-stuffed pastel organic balloons, fresh baby\'s breath, and modern ribbed arch panels. Customized with the celebrant\'s name in warm neon glow and graduated acrylic plinths for the birthday cake.\",\n    features: [\n      \"Organic balloon garland with chrome gold & pastel double-stuffed balloons\",\n      \"Set of 3 curved arched backdrop panels in pastel lilac, blush, and mint\",\n      \"Customizable warm LED neon sign with name or celebratory quote\",\n      \"Trio of fluted cylinder cake plinths with acrylic cake stands\",\n      \"Delicate fresh floral clusters woven throughout the garland\",\n      \"Stage carpet in matching pastel cream tone with edge lighting\"\n    ],\n    specs: {\n      setupDuration: \"3 \342\200\223 4 Hours\",\n      backdropDimensions: \"18 ft (W) \303\227 9 ft (H)\",\n      floralType: \"Baby\'s breath, pastel hydrangeas & double-stuffed balloons\",\n      lighting: \"Custom neon sign + warm ambient floodlighting\",\n      idealVenues: \"Party halls, banquet rooms, home living halls, clubhouses\",\n      seatingProvided: \"Single luxury pastel tub chair or plinth grouping\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1546815140-4ef85b8b7a42?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Pastel Lilac\", \"Soft Peach\", \"Chrome Gold\"],\n    featured: false,\n    isMostLoved: false,\n    badge: \"Birthday Special\"\n  },\n  {\n    id: \"celestial-star-baby-shower-stage\",\n    name: \"Celestial Star Baby Shower Stage\",\n    category: \"Baby Shower\",\n    style: \"Minimal\",\n    tagline: \"Gentle pastel skies welcoming your newest blessing.\",\n    shortDescription: \"Warm crescent moon backdrop, fluffy white floral clouds, and delicate starry illumination for a tender baby shower.\",\n    fullDescription: \"A heartfelt stage design honoring the arrival of a precious bundle of joy. Features a bespoke 7-foot crescent moon structure surrounded by fluffy cloud-like baby\'s breath and pastel eucalyptus foliage. Gentle star cutouts with warm backlighting create a serene, photogenic sanctuary for mother-to-be portraits and family blessings.\",\n    features: [\n      \"Custom 7-foot illuminated warm crescent moon installation\",\n      \"Billowing clouds of white baby\'s breath and silver dollar eucalyptus\",\n      \"Backlit wooden stars suspended at varying heights\",\n      \"Ultra-comfortable padded maternity armchair with footrest\",\n      \"Customized welcome board with \'Welcome Baby\' or parent names\",\n      \"Themed guest photo corner with polaroid blessing tree\"\n    ],\n    specs: {\n      setupDuration: \"3 \342\200\223 4 Hours\",\n      backdropDimensions: \"20 ft (W) \303\227 10 ft (H)\",\n      floralType: \"Million-star gypsophila (baby\'s breath) & eucalyptus greens\",\n      lighting: \"Soft warm celestial glow, star string lights & backlighting\",\n      idealVenues: \"Boutique party halls, home gardens & banquet spaces\",\n      seatingProvided: \"Plush velvet maternity armchair with lumbar support cushion\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1546815140-4ef85b8b7a42?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Cloud White\", \"Soft Sky\", \"Butter Yellow\"],\n    featured: false,\n    isMostLoved: false,\n    badge: \"Baby Shower\"\n  },\n  {\n    id: \"jasmine-brass-traditional-mandapam\",\n    name: \"Jasmine & Brass Traditional Kalyana Mandapam\",\n    category: \"Traditional\",\n    style: \"Traditional\",\n    tagline: \"Sacred chants, fragrant jasmine, and pure timeless Kerala grace.\",\n    shortDescription: \"A four-pillar sacred Kalyana Mandapam with thousands of fresh jasmine strands, lotus bowls, and brass Vilakku.\",\n    fullDescription: \"Built specifically for Hindu marriage ceremonies across Malabar and Kerala temples. This four-pillared mandapam is draped entirely with thousands of fragrant white jasmine (mulla) strings and sacred golden champaka flowers. The mandap platform accommodates the sacred homam fire pit, brass paras, and family seating with complete architectural safety and traditional decorum.\",\n    features: [\n      \"Four authentic carved ceremonial pillars supporting a floral canopy\",\n      \"Over 4,000 fragrant fresh Madurai jasmine (pichi) malas\",\n      \"Traditional brass Thookkuvilakku (hanging oil lamps) with bells\",\n      \"Handmade lotus petal rangoli borders around ceremonial dais\",\n      \"Fire-safe homam hearth boundary with brass ceremonial accessories\",\n      \"Traditional Kasavu-bordered carpet across the entire dais\"\n    ],\n    specs: {\n      setupDuration: \"6 \342\200\223 7 Hours\",\n      backdropDimensions: \"24 ft (W) \303\227 16 ft (D) \303\227 12 ft (H)\",\n      floralType: \"Fresh Madurai jasmine, pink lotus buds, yellow marigold\",\n      lighting: \"Warm spotlighting combined with authentic brass lamp glow\",\n      idealVenues: \"Temple Kalyana Mandapams, auditorium stages, heritage venues\",\n      seatingProvided: \"Traditional carved wooden wedding peedam with cushions\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1544077960-604201fe74bc?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1545232979-8bf68ee9b1af?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Jasmine White\", \"Temple Brass\", \"Sacred Saffron\"],\n    featured: true,\n    isMostLoved: true,\n    badge: \"Sacred Mandapam\"\n  },\n  {\n    id: \"crimson-romance-floral-wedding-arch\",\n    name: \"Crimson Romance Floral Wedding Arch\",\n    category: \"Wedding\",\n    style: \"Floral\",\n    tagline: \"Deep passionate crimson roses and dramatic romantic flair.\",\n    shortDescription: \"Dramatic wall of dense red Bangalore roses, cascading burgundy amaranthus, and subtle gold candelabras.\",\n    fullDescription: \"For couples who desire timeless, dramatic romance. The Crimson Romance stage boasts a dense, continuous wall of thousands of fresh deep-red Bangalore roses, accented by trailing burgundy amaranthus and Italian ruscus. Golden tall candelabras add height and warm flickering illumination to complement the bride\342\200\231s wedding gown or saree.\",\n    features: [\n      \"Continuous wall of over 5,000 deep crimson Bangalore roses\",\n      \"Cascading burgundy amaranthus & glossy dark Italian ruscus\",\n      \"Pair of 7-foot tall antique gold candelabra pedestals\",\n      \"Tufted velvet romantic double loveseat in champagne gold\",\n      \"Elevated stage deck with matching deep crimson aisle runner\",\n      \"Dimmable warm edge lighting highlighting floral textures\"\n    ],\n    specs: {\n      setupDuration: \"6 \342\200\223 8 Hours\",\n      backdropDimensions: \"28 ft (W) \303\227 12 ft (H)\",\n      floralType: \"Premium dark crimson Bangalore roses, burgundy amaranthus\",\n      lighting: \"Soft warm directional profile spots & gold candelabras\",\n      idealVenues: \"Large banquet halls, hotel auditoriums, wedding conventions\",\n      seatingProvided: \"Champagne gold tufted velvet romantic double sofa\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Crimson Red\", \"Champagne Gold\", \"Velvet Black\"],\n    featured: false,\n    isMostLoved: false,\n    badge: \"Romantic Crimson\"\n  },\n  {\n    id: \"minimalist-geometric-white-stage\",\n    name: \"Minimalist Geometric White Stage\",\n    category: \"Reception\",\n    style: \"Minimal\",\n    tagline: \"Understated modern architecture for contemporary elegance.\",\n    shortDescription: \"Clean curved geometric arches with monochromatic white blooms, baby\'s breath, and architectural lighting.\",\n    fullDescription: \"A breath of fresh, contemporary air. Departing from heavy ornamentation, this setup relies on architectural precision, clean lines, and subtle texture. Intersecting curved white arches frame modern cloud-like clusters of gypsophila, white hydrangeas, and trailing orchids. Tailored for stylish receptions and modern Christian weddings.\",\n    features: [\n      \"Intersecting curved matte-white architectural arch sculptures\",\n      \"Sculpted clouds of white gypsophila and trailing white orchids\",\n      \"Modern asymmetrical curved white sofa with boucl\303\251 fabric\",\n      \"Concealed indirect warm white architectural LED illumination\",\n      \"Matte seamless white dance floor and stage perimeter\",\n      \"Discreet floral arrangements for dining hall VIP tables to match\"\n    ],\n    specs: {\n      setupDuration: \"5 \342\200\223 6 Hours\",\n      backdropDimensions: \"26 ft (W) \303\227 12 ft (H)\",\n      floralType: \"White gypsophila, Dutch hydrangeas & white phalaenopsis\",\n      lighting: \"Concealed 3000K warm white linear wash lights\",\n      idealVenues: \"Modern convention centers, indoor auditoriums, hotel ballrooms\",\n      seatingProvided: \"Curved white boucl\303\251 contemporary designer settee\"\n    },\n    images: [\n      \"https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1200&q=80\",\n      \"https://images.unsplash.com/photo-1546815140-4ef85b8b7a42?auto=format&fit=crop&w=1200&q=80\"\n    ],\n    colorThemes: [\"Pure White\", \"Warm Cream\", \"Soft Linen\"],\n    featured: false,\n    isMostLoved: false,\n    badge: \"Architectural Minimal\"\n  }\n];\n"
    }
