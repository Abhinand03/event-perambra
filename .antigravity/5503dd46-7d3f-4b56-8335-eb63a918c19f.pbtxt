       id=\"floating-whatsapp-btn\"\n      >\n        <MessageCircle className=\"w-6 h-6 fill-white text-[#25D366]\" />\n        <span className=\"hidden md:inline font-semibold text-sm tracking-wide\">\n          Enquire on WhatsApp\n        </span>\n      </motion.a>\n    </div>\n  );\n};\n"
    }
